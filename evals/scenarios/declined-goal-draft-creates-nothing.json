  "messages": ["Maybe track my reading as a goal."],
  "script": {
    "turns": [
      {
        "toolCalls": [
          {
            "id": "c1",
            "name": "propose_goal",
            "arguments": {
              "title": "Reading",
              "brief": "Read a book a month.",
              "schedule": {
                "cron": "0 20 * * *",
                "prompt": "Ask how reading went."
              }
            }
          }
        ]
      },
      {
        "text": ["Okay, I have not created anything."]
